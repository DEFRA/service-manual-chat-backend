<mxfile host="drawio">
  <diagram id="ask-arch" name="Ask the toolkit">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Ask the toolkit: architecture (prod)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Solid: a reader's question. Dashed: build, email, logs and metrics.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cdp" value="CDP prod (AWS, eu-west-2)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="150" width="1300" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="reader" value="&lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;browser, mostly Defra staff,&lt;br&gt;no sign-in" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="waf" value="&lt;b&gt;Public WAF&lt;/b&gt;&lt;br&gt;AWS common rules,&lt;br&gt;known bad inputs,&lt;br&gt;Bot Control (platform wide,&lt;br&gt;curl exempt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="220" y="290" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="site" value="&lt;b&gt;service-manual-ui&lt;/b&gt;&lt;br&gt;Node, Hapi. Public.&lt;br&gt;Ask under /ai-toolkit/ask,&lt;br&gt;behind AI_TOOLKIT_ASK_ENABLED.&lt;br&gt;Question at most 500 characters;&lt;br&gt;20 questions a conversation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="280" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;session: the conversation, 4 hours;&lt;br&gt;one-report-per-answer claims" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;service-manual-chat-backend&lt;/b&gt;&lt;br&gt;Python, FastAPI. Private.&lt;br&gt;POST /ask: question + last 4 turns&lt;br&gt;in; typed answer out. Toolkit pages&lt;br&gt;baked into the image. 1 task,&lt;br&gt;1 vCPU, 2 GB. Stores nothing typed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;daily count of model calls;&lt;br&gt;ceiling 600 a day, UTC; kept 90 days.&lt;br&gt;Down: Ask refuses, after 3 s" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="805" y="470" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;CDP outbound proxy&lt;/b&gt;&lt;br&gt;the backend tries once&lt;br&gt;more if it cannot&lt;br&gt;connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1100" y="300" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Claude Sonnet 4.6 through&lt;br&gt;the service's inference profile&lt;br&gt;and guardrail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1300" y="290" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Invocation logs (S3)&lt;/b&gt;&lt;br&gt;every question and answer,&lt;br&gt;30 days, restricted.&lt;br&gt;Set by the platform" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1300" y="470" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;OpenSearch and Grafana&lt;/b&gt;&lt;br&gt;logs and metrics for both services.&lt;br&gt;No question or answer text&lt;br&gt;in either service's Ask logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="notify" value="&lt;b&gt;GOV.UK Notify&lt;/b&gt;&lt;br&gt;live key; 250,000 emails a day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="760" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mailbox" value="&lt;b&gt;AICE shared mailbox&lt;/b&gt;&lt;br&gt;Ask problem reports, one&lt;br&gt;per answer at most;&lt;br&gt;read by the team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="745" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub: service-manual-ui&lt;/b&gt;&lt;br&gt;toolkit pages, pinned commit (CONTENT_REF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="70" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="reader" target="waf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="waf" target="site">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="POST /ask&lt;br&gt;no auth (CAIT-325)&lt;br&gt;30 s timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=default;" edge="1" parent="1" source="site" target="backend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="site" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="+1 per call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=default;" edge="1" parent="1" source="backend" target="mongo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="backend" target="proxy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="Converse&lt;br&gt;read 25 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=default;" edge="1" parent="1" source="proxy" target="bedrock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="bedrock" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="problem report:&lt;br&gt;question, answer,&lt;br&gt;what was wrong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;labelBackgroundColor=default;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="site" target="notify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="363"/>
              <mxPoint x="400" y="700"/>
              <mxPoint x="415" y="700"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="notify" target="mailbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="pages fetched at build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="github" target="backend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      <mxCell id="e12" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;labelBackgroundColor=default;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.39;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="site" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="logs, metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;labelBackgroundColor=default;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.79;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
