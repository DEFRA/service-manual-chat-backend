# Copy to compose/secrets.env (gitignored). One line per secret, no quotes.
# Your own AWS credentials, exported from ~/.aws/credentials:
#   aws configure export-credentials --profile <your profile> --format env-no-export > compose/secrets.env
# They are temporary; export again when Bedrock answers 403. Never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
